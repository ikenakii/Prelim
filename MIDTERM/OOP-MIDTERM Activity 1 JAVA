package com.mycompany.mavenproject1;

import java.util.Scanner;
import java.util.Arrays;
import java.io.BufferedReader;
import java.io.FileReader;
import java.time.LocalDate;

public class Mavenproject1 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String cont;
        
        do {
            System.out.println("Choose the program you want to run");
            System.out.println("Number 1");
            System.out.println("Number 2");
            System.out.println("Number 3");
            System.out.println("Number 4");
            System.out.println("Number 5");
            System.out.println("Number 6");
            System.out.println("Number 7");
            
            System.out.print("Enter choice: ");
            int ch = sc.nextInt();
            
            if (ch == 1) {
                double[] num = new double[10];
                System.out.println("Enter 10 real numbers (negative and positive):");
                for (int i = 0; i < 10; i++) {
                    num[i] = sc.nextDouble();
                }
                
                // Loop 1: Find sum and average of positive numbers
                double sum = 0;
                int posCount = 0;
                for (int i = 0; i < 10; i++) {
                    if (num[i] > 0) {
                        sum += num[i];
                        posCount++;
                    }
                }
                double avg = (posCount > 0) ? (sum / posCount) : 0;
                System.out.println("Sum of positive numbers: " + sum);
                System.out.println("Average of positive numbers: " + avg);
                
                // Loop 2: Count negative numbers
                int negCount = 0;
                for (int i = 0; i < 10; i++) {
                    if (num[i] < 0) {
                        negCount++;
                    }
                }
                System.out.println("Count of negative numbers: " + negCount);
                
                // Loop 3: Find the smallest number
                double min = num[0];
                for (int i = 1; i < 10; i++) {
                    if (num[i] < min) {
                        min = num[i];
                    }
                }
                System.out.println("Minimum value: " + min);
                
            } else if (ch == 2) {
                int[] num = new int[8];
                System.out.println("Enter 8 integer numbers:");
                for (int i = 0; i < 8; i++) {
                    num[i] = sc.nextInt();
                }
                
                // Sort numbers from lowest to highest
                Arrays.sort(num);
                int[] unique = new int[8];
                int k = 0;
                
                // Remove matching numbers next to each other
                for (int i = 0; i < 8; i++) {
                    if (i == 0 || num[i] != num[i - 1]) {
                        unique[k] = num[i];
                        k++;
                    }
                }
                
                System.out.print("Array after removing duplicates: ");
                for (int i = 0; i < k; i++) {
                    System.out.print(unique[i] + " ");
                }
                System.out.println();
                
                // Find second lowest and second highest numbers
                if (k >= 2) {
                    System.out.println("Second smallest element: " + unique[1]);
                    System.out.println("Second largest element: " + unique[k - 2]);
                } else {
                    System.out.println("Not enough unique elements.");
                }
                
            } else if (ch == 3) {
                int[] arr = new int[5];
                System.out.print("Enter Data in Array: ");
                for (int i = 0; i < 5; i++) {
                    arr[i] = sc.nextInt();
                }
                
                System.out.print("Stored Data in Array: ");
                for (int i = 0; i < 5; i++) { 
                    System.out.print(arr[i] + " ");
                }
                System.out.println();
                
                System.out.print("Enter poss. of Element to Delete: ");
                int pos = sc.nextInt();
                
                int currentSize = 5;
                if (pos >= 0 && pos < currentSize) {
                    // Shift items left to erase the selected item
                    for (int i = pos; i < currentSize - 1; i++) {
                        arr[i] = arr[i + 1];
                    }
                    currentSize--; // Make the active size smaller
                    
                    System.out.print("New data in Array: ");
                    for (int i = 0; i < currentSize; i++) {
                        System.out.print(arr[i] + " ");
                    }
                    System.out.println();
                } else {
                    System.out.println("Invalid position!");
                }
                
            } else if (ch == 4) {
                System.out.print("Enter Size of Array : ");
                int sz = sc.nextInt();
                int[] arr = new int[sz];
                
                System.out.println("Enter any " + sz + " elements in Array:");
                for (int i = 0; i < sz; i++) {
                    arr[i] = sc.nextInt();
                }
                
                // Show even numbers
                System.out.print("Even Elements: ");
                for (int i = 0; i < sz; i++) {
                    if (arr[i] % 2 == 0) {
                        System.out.print(arr[i] + " ");
                    }
                }
                System.out.println();
                
                // Show odd numbers
                System.out.print("Odd Elements: ");
                for (int i = 0; i < sz; i++) {
                    if (arr[i] % 2 != 0) {
                        System.out.print(arr[i] + " ");
                    }
                }
                System.out.println();
                
            } else if (ch == 5) {
                System.out.println("OUTPUT:");
                for (int i = 1; i <= 4; i++) {
                    for (int j = 1; j <= i; j++) {
                        System.out.print("*");
                        if (j < i) {
                            System.out.print("A");
                        }
                    }
                    System.out.println();
                }
                
            } else if (ch == 6) {
                // Test the empty constructor
                Student s1 = new Student();
                System.out.println("Student 1 (Default) -> No: " + s1.getStudentNo() + 
                                   ", Name: " + s1.getStudentName() + 
                                   ", DOB: " + s1.getDateOfBirth() + 
                                   ", Points: " + s1.getTariffPoints());
                
                // Test the constructor with data parameters
                Student s2 = new Student("S101", "John Doe", LocalDate.of(1995, 1, 1), 150);
                System.out.println("Student 2 (Param) -> No: " + s2.getStudentNo() + 
                                   ", Name: " + s2.getStudentName() + 
                                   ", DOB: " + s2.getDateOfBirth() + 
                                   ", Points: " + s2.getTariffPoints());
                                   
                System.out.println("Total Students Instance Count: " + Student.noOfStudents);
                
            } else if (ch == 7) {
                System.out.println("[Debug Path Info] Place your file here named exactly 'rap': " + new java.io.File("rap").getAbsolutePath());
                
                // CHANGED: Now looking for the file named "rap" instead of "data.txt"
                try (BufferedReader br = new BufferedReader(new FileReader("rap"))) {
                    String line;
                    int count = 0;
                    
                    System.out.println("\n--- Processing File Record Data ---");
                    while ((line = br.readLine()) != null) {
                        String[] splitData = line.split("\t");
                        if (splitData.length >= 3) {
                            System.out.println("Record Found -> ID: " + splitData[0].trim() + 
                                               " | Name: " + splitData[1].trim() + 
                                               " | Mobile: " + splitData[2].trim());
                            count++;
                        }
                    }
                    System.out.println("Successfully processed " + count + " records.");
                } catch (Exception e) {
                    System.out.println("File Message: " + e.getMessage());
                }
            }
            
            System.out.print("Do you want to continue ? Y/N: ");
            cont = sc.next();
        } while (cont.equalsIgnoreCase("Y"));
        
        sc.close();
    }
}

// Student template class
class Student {
    private String studentNo;
    private String studentName;
    private LocalDate dateOfBirth;
    private int tariffPoints;
    public static int noOfStudents = 0;
    
    // Default constructor setup
    public Student() {
        this.studentNo = "not known";
        this.studentName = "not known";
        this.dateOfBirth = LocalDate.of(1995, 1, 1);
        this.tariffPoints = 20;
        noOfStudents++;
    }
    
    // Constructor using custom input data with rule checks
    public Student(String studentNo, String studentName, LocalDate dateOfBirth, int tariffPoints) {
        this.studentNo = studentNo;
        this.studentName = studentName;
        this.dateOfBirth = dateOfBirth;
        if (tariffPoints >= 20 && tariffPoints <= 280) {
            this.tariffPoints = tariffPoints;
        } else {
this.tariffPoints = 20;
}
noOfStudents++;
}
// Getters and Setters to read and edit fields safely
public String getStudentNo() { return studentNo; }
public void setStudentNo(String studentNo) { this.studentNo = studentNo; }
public String getStudentName() { return studentName; }
public void setStudentName(String studentName) { this.studentName = studentName; }
public LocalDate getDateOfBirth() { return dateOfBirth; }
public void setDateOfBirth(LocalDate dateOfBirth) { this.dateOfBirth = dateOfBirth; }
public int getTariffPoints() { return tariffPoints; }
public void setTariffPoints(int tariffPoints) {
if (tariffPoints >= 20 && tariffPoints <= 280) {
this.tariffPoints = tariffPoints;
} else {
this.tariffPoints = 20;
}
}
}
