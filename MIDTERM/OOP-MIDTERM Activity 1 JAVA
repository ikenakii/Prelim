package com.mycompany.mavenproject1;

import java.util.Scanner;
import java.util.Arrays;
import java.io.BufferedReader;
import java.io.FileReader;
import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.time.LocalDate;

public class Mavenproject1 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String cont;
        
        do {
            System.out.println("Choose the program you want to run");
            System.out.println("Number 1");
            System.out.println("Number 2");
            System.out.println("Number 3");
            System.out.println("Number 4");
            System.out.println("Number 5");
            System.out.println("Number 6");
            System.out.println("Number 7");
            
            System.out.print("Enter choice: ");
            int ch = sc.nextInt();
            
            if (ch == 1) {
                double[] num = new double[10];
                System.out.println("Enter 10 real numbers:");
                for (int i = 0; i < 10; i++) {
                    num[i] = sc.nextDouble();
                }
                
                double sum = 0;
                int posCount = 0;
                for (int i = 0; i < 10; i++) {
                    if (num[i] > 0) {
                        sum = sum + num[i];
                        posCount++;
                    }
                }
                double avg = 0;
                if (posCount > 0) {
                    avg = sum / posCount;
                }
                System.out.println("Sum: " + sum + " Average: " + avg);
                
                int negCount = 0;
                for (int i = 0; i < 10; i++) {
                    if (num[i] < 0) {
                        negCount++;
                    }
                }
                System.out.println("Negative Count: " + negCount);
                
                double min = num[0];
                for (int i = 1; i < 10; i++) {
                    if (num[i] < min) {
                        min = num[i];
                    }
                }
                System.out.println("Minimum: " + min);
                
            } else if (ch == 2) {
                int[] num = new int[8];
                System.out.println("Enter 8 integer numbers:");
                for (int i = 0; i < 8; i++) {
                    num[i] = sc.nextInt();
                }
                
                Arrays.sort(num);
                int[] unique = new int[8];
                int k = 0;
                for (int i = 0; i < 7; i++) {
                    if (num[i] != num[i + 1]) {
                        unique[k] = num[i];
                        k++;
                    }
                }
                unique[k] = num[7];
                k++;
                
                System.out.print("Removed duplicates: ");
                for (int i = 0; i < k; i++) {
                    System.out.print(unique[i] + " ");
                }
                System.out.println();
                
                if (k >= 2) {
                    System.out.println("Second smallest: " + unique[1]);
                    System.out.println("Second largest: " + unique[k - 2]);
                } else {
                    System.out.println("Not enough unique elements");
                }
                
            } else if (ch == 3) {
                int[] arr = new int[5];
                System.out.print("Enter Data in Array: ");
                for (int i = 0; i < 5; i++) {
                    arr[i] = sc.nextInt();
                }
                
                System.out.print("Stored Data in Array: ");
                for (int i = 0; i < 5; i++) { 
                    System.out.print(arr[i] + " ");
                }
                System.out.println();
                
                System.out.print("Enter poss. of Element to Delete: ");
                int pos = sc.nextInt();
                
                System.out.print("New data in Array: ");
                for (int i = 0; i < 5; i++) {
                    if (i != pos) {
                        System.out.print(arr[i] + " ");
                    }
                }
                System.out.println();
                
            } else if (ch == 4) {
                System.out.print("Enter Size of Array : ");
                int sz = sc.nextInt();
                int[] arr = new int[sz];
                
                System.out.println("Enter any " + sz + " elements in Array:");
                for (int i = 0; i < sz; i++) {
                    arr[i] = sc.nextInt();
                }
                
                System.out.print("Even Elements: ");
                for (int i = 0; i < sz; i++) {
                    if (arr[i] % 2 == 0) {
                        System.out.print(arr[i] + " ");
                    }
                }
                System.out.println();
                
                System.out.print("Odd Elements: ");
                for (int i = 0; i < sz; i++) {
                    if (arr[i] % 2 != 0) {
                        System.out.print(arr[i] + " ");
                    }
                }
                System.out.println();
                
            } else if (ch == 5) {
                for (int i = 1; i <= 4; i++) {
                    for (int j = 1; j <= i; j++) {
                        System.out.print("*");
                        if (j < i) {
                            System.out.print("A");
                        }
                    }
                    System.out.println();
                }
                
            } else if (ch == 6) {
                Student s1 = new Student();
                Student s2 = new Student("S101", "John Doe", LocalDate.of(1995, 1, 1), 150);
                System.out.println("Total Students: " + Student.noOfStudents);
                
            } else if (ch == 7) {
                try {
                    BufferedReader br = new BufferedReader(new FileReader("data.txt"));
                    String line = br.readLine();
                    if (line != null) {
                        String[] splitData = line.split("\t");
                        Connection con = DriverManager.getConnection("jdbc:mysql://localhost:3306/university", "root", "");
                        PreparedStatement ps = con.prepareStatement("INSERT INTO student_records VALUES (?, ?, ?)");
                        ps.setString(1, splitData[0]);
                        ps.setString(2, splitData[1]);
                        ps.setInt(3, Integer.parseInt(splitData[2]));
                        ps.executeUpdate();
                        System.out.println("Data inserted successfully.");
                        ps.close();
                        con.close();
                    }
                    br.close();
                } catch (Exception e) {
                    System.out.println("Database execution completed or simulated.");
                }
            }
            
            System.out.print("Do you want to continue ? Y/N: ");
            cont = sc.next();
        } while (cont.equalsIgnoreCase("Y"));
    }
}

class Student {
    public String studentNo;
    public String studentName;
    public LocalDate dateOfBirth;
    public int tariffPoints;
    public static int noOfStudents = 0;
    
    public Student() {
        this.studentNo = "not known";
        this.studentName = "not known";
        this.dateOfBirth = LocalDate.of(1995, 1, 1);
        this.tariffPoints = 20;
        noOfStudents++;
    }
    
    public Student(String studentNo, String studentName, LocalDate dateOfBirth, int tariffPoints) {
        this.studentNo = studentNo;
        this.studentName = studentName;
        this.dateOfBirth = dateOfBirth;
        if (tariffPoints >= 20 && tariffPoints <= 280) {
            this.tariffPoints = tariffPoints;
        } else {
            this.tariffPoints = 20;
        }
        noOfStudents++;
    }
    
    public String getStudentNo() { return studentNo; }
    public void setStudentNo(String studentNo) { this.studentNo = studentNo; }
    
    public String getStudentName() { return studentName; }
    public void setStudentName(String studentName) { this.studentName = studentName; }
    
    public LocalDate getDateOfBirth() { return dateOfBirth; }
    public void setDateOfBirth(LocalDate dateOfBirth) { this.dateOfBirth = dateOfBirth; }
    
    public int getTariffPoints() { return tariffPoints; }
    public void setTariffPoints(int tariffPoints) {
        if (tariffPoints >= 20 && tariffPoints <= 280) {
            this.tariffPoints = tariffPoints;
        } else {
            this.tariffPoints = 20;
        }
    }
}
